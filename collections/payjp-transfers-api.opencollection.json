{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Transfers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transfers (入金)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/transfers"
          },
          "docs": "List transfers (入金)"
        },
        {
          "info": {
            "name": "Retrieve a transfer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a transfer"
        },
        {
          "info": {
            "name": "List the charges settled in a transfer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/transfers/:id/details",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List the charges settled in a transfer"
        }
      ]
    }
  ],
  "bundled": true
}