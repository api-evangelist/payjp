{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Cards API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a customer's cards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/customers/:id/cards",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List a customer's cards"
        },
        {
          "info": {
            "name": "Attach a card to a customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/customers/:id/cards",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "card",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Attach a card to a customer"
        },
        {
          "info": {
            "name": "Retrieve a customer's card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/customers/:id/cards/:card_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "card_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a customer's card"
        },
        {
          "info": {
            "name": "Update a customer's card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/customers/:id/cards/:card_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "card_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a customer's card"
        },
        {
          "info": {
            "name": "Delete a customer's card",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pay.jp/v1/customers/:id/cards/:card_id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "card_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a customer's card"
        }
      ]
    }
  ],
  "bundled": true
}