{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Charges API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Charges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List charges",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/charges",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List charges"
        },
        {
          "info": {
            "name": "Create a charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "currency",
                  "value": ""
                },
                {
                  "name": "card",
                  "value": ""
                },
                {
                  "name": "customer",
                  "value": ""
                },
                {
                  "name": "capture",
                  "value": ""
                },
                {
                  "name": "description",
                  "value": ""
                },
                {
                  "name": "metadata",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a charge against a card token, a customer, or a stored card. Set capture=false to authorize only and capture later."
        },
        {
          "info": {
            "name": "Retrieve a charge",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/charges/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a charge"
        },
        {
          "info": {
            "name": "Update a charge (description / metadata)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a charge (description / metadata)"
        },
        {
          "info": {
            "name": "Refund a charge (full or partial)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges/:id/refund",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "refund_reason",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Refund a charge (full or partial)"
        },
        {
          "info": {
            "name": "Capture a previously authorized charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges/:id/capture",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Capture a previously authorized charge"
        },
        {
          "info": {
            "name": "Re-authorize an expiring authorization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges/:id/reauth",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Re-authorize an expiring authorization"
        },
        {
          "info": {
            "name": "Complete the 3D Secure flow for a charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/charges/:id/tds_finish",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Complete the 3D Secure flow for a charge"
        }
      ]
    }
  ],
  "bundled": true
}