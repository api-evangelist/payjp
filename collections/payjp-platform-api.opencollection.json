{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Platform API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Platform",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List platform tenants (beta)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/tenants"
          },
          "docs": "List platform tenants (beta)"
        },
        {
          "info": {
            "name": "Create a platform tenant (sub-merchant)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/tenants"
          },
          "docs": "Create a platform tenant (sub-merchant)"
        },
        {
          "info": {
            "name": "Retrieve a tenant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/tenants/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a tenant"
        },
        {
          "info": {
            "name": "Update a tenant",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/tenants/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a tenant"
        },
        {
          "info": {
            "name": "Delete a tenant",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pay.jp/v1/tenants/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a tenant"
        },
        {
          "info": {
            "name": "List tenant transfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/tenant_transfers"
          },
          "docs": "List tenant transfers"
        },
        {
          "info": {
            "name": "Retrieve a tenant transfer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/tenant_transfers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a tenant transfer"
        }
      ]
    }
  ],
  "bundled": true
}