{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Terms API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Terms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List aggregation terms (集計区間)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/terms"
          },
          "docs": "List aggregation terms (集計区間)"
        },
        {
          "info": {
            "name": "Retrieve a term",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/terms/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a term"
        }
      ]
    }
  ],
  "bundled": true
}