{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Plans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/plans"
          },
          "docs": "List plans"
        },
        {
          "info": {
            "name": "Create a recurring plan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/plans",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "currency",
                  "value": ""
                },
                {
                  "name": "interval",
                  "value": ""
                },
                {
                  "name": "trial_days",
                  "value": ""
                },
                {
                  "name": "billing_day",
                  "value": ""
                },
                {
                  "name": "name",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a recurring plan"
        },
        {
          "info": {
            "name": "Retrieve a plan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/plans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a plan"
        },
        {
          "info": {
            "name": "Update a plan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/plans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a plan"
        },
        {
          "info": {
            "name": "Delete a plan",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pay.jp/v1/plans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a plan"
        }
      ]
    }
  ],
  "bundled": true
}