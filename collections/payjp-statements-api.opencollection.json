{
  "opencollection": "1.0.0",
  "info": {
    "name": "PAY.JP 3D Secure Statements API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transaction statements (取引明細)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/statements"
          },
          "docs": "List transaction statements (取引明細)"
        },
        {
          "info": {
            "name": "Retrieve a statement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pay.jp/v1/statements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a statement"
        },
        {
          "info": {
            "name": "Issue a signed CSV download URL for a statement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pay.jp/v1/statements/:id/statement_urls",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Issue a signed CSV download URL for a statement"
        }
      ]
    }
  ],
  "bundled": true
}